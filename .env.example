# Copy to .env for local development. Replace before public deployment.
POSTGRES_DB=techtrithalon
POSTGRES_USER=techtrithalon
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=5173
INTELLIGENCE_PORT=8000
APP_TIME_ZONE=Asia/Colombo
VITE_API_BASE_URL=http://localhost:8080
INTELLIGENCE_BASE_URL=http://intelligence:8000
WEB_ORIGINS=http://localhost:5173

# Optional: reference-data location and expected row counts.
# Defaults match the supplied dataset. CI overrides these to use synthetic fixtures.
# REFERENCE_DATA_HOST_DIR=./dataset/data/General Data
DEMO_OPERATING_DATE=2026-06-26

# Session cookies: false for local HTTP; true for HTTPS deployments.
COOKIE_SECURE=false
SESSION_TTL=PT16H
SEED_ACCOUNTS_ENABLED=true
# Set unique passwords of at least 12 characters before the first startup.
SEED_DISPATCHER_USERNAME=DSP-001
SEED_DISPATCHER_PASSWORD=
SEED_STORE_MANAGER_USERNAME=STM-001
SEED_STORE_MANAGER_PASSWORD=
SEED_STORE_MANAGER_OUTLET=OUT001
SEED_LOADER_USERNAME=LDR-001
SEED_LOADER_PASSWORD=
SEED_LOADER_DEPOT=Peliyagoda
SEED_DRIVER_USERNAME=DRV-001
SEED_DRIVER_PASSWORD=
